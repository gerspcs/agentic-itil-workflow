# Copy this file to .env and fill in the values. .env is gitignored; never commit it.
#   cp .env.example .env

# Required for live runs: your TypeSafe API key (https://typesafe.ai).
TYPESAFE_API_KEY=

# Optional: TypeSafe model name. Default: jev-latest
# TYPESAFE_MODEL=jev-latest

# Optional: which c8ctl profile points at your Camunda 8 engine.
# Leave blank to use c8ctl's active profile. See "Run it" in the README.
# C8CTL_PROFILE=agentic-lab

# Optional: Camunda 8 REST address used by the live viewer. Default: http://localhost:8080/v2
# CAMUNDA_REST=http://localhost:8080/v2
