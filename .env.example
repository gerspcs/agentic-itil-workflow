# Copy this file to .env and fill in the values. .env is gitignored; never commit it.
#   cp .env.example .env

# Required for live runs: your TypeSafe API key (https://typesafe.ai).
TYPESAFE_API_KEY=

# Optional: TypeSafe model name. Default: jev-latest
# TYPESAFE_MODEL=jev-latest

# Optional: which c8ctl profile points at your Camunda 8 engine. scripts/lab.sh uses
# "agentic-lab" (it creates that profile for you). If you run the worker by hand and
# leave this blank, c8ctl's currently active profile is used.
# C8CTL_PROFILE=agentic-lab

# Optional: the engine's REST port (scripts/lab.sh and the viewer both use it). Default: 8080
# C8_PORT=8080
# Optional: the live viewer's port. Default: 8099
# UI_PORT=8099
# Optional: the Camunda 8 version scripts/lab.sh downloads and starts. Default: 8.10.0-alpha5
# C8_VERSION=8.10.0-alpha5
# Optional: the full REST address, if the engine is not on this machine. Default: http://localhost:<C8_PORT>/v2
# CAMUNDA_REST=http://localhost:8080/v2
