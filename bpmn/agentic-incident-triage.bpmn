<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_AgenticIncident" targetNamespace="http://insights.local/bpmn/agentic-incident-triage"
  exporter="Claude Code" exporterVersion="2026-09-26">
  <bpmn:message id="Message_Alert" name="Alert (monitoring/event system)"/>
  <bpmn:collaboration id="Collaboration_Incident">
    <bpmn:participant id="Participant_Incident" name="Incident Management (agentic, TypeSafe judgments)" processRef="Process_Incident"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Incident" name="Agentic Incident Triage" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Incident">
      <bpmn:lane id="Lane_Agent" name="Agent (TypeSafe judgments)">
        <bpmn:flowNodeRef>StartEvent_Alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enrich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifySeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MatchPattern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AutoCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoRemediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Converge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Postmortem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClusterProblem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CSISignal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClosedNoAction</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Human" name="Human (on-call / CSI owner)">
        <bpmn:flowNodeRef>Task_HumanTriage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateHuman</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmRootCause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClosedCSI</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Alert" name="Alert received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Alert" messageRef="Message_Alert"/>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Enrich" name="Enrich event&#10;(telemetry, history)">
      <bpmn:documentation>Code, not a judgment: pulls telemetry, recent deploys, and prior incidents for this service into state. This is the context a TypeSafe question will need next.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enrich-event"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_ClassifySeverity" name="Classify severity&#10;[TypeSafe: Choice]">
      <bpmn:documentation>TypeSafe primitive: Choice over {cosmetic, minor, major, critical}, given the enriched event as state. Criteria describe each severity level concretely (user impact, blast radius). Choice's distribution is read for confidence, not just the top label.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="typesafe-classify-severity"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:businessRuleTask id="Task_MatchPattern" name="Match known playbook?&#10;[TypeSafe: Noul]">
      <bpmn:documentation>TypeSafe primitive: Noul — probability that this event matches a validated, previously-confirmed remediation playbook. Runs alongside a code-side reversibility lookup (is the candidate action reversible in this environment) so the gateway can require both.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="typesafe-match-pattern"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_AutoCandidate" name="Confidence &#8805; threshold&#10;AND reversible?" default="Flow_ToHumanTriage">
      <bpmn:documentation>Human-in-the-loop gate 1. Condition requires BOTH a high Noul probability (matchConfidence &#8805; 0.8) and a code-verified reversible action — a confident judgment on an irreversible action still routes to a human. Threshold is set from observed data (confidence.md), not a fixed universal number.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAutoRemediate</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToHumanTriage</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AutoRemediate" name="Auto-remediate&#10;(run playbook)">
      <bpmn:documentation>Code executes the matched, pre-approved playbook. No new judgment here — the judgment already happened at Task_MatchPattern; this is deterministic execution.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-remediate"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAutoRemediate</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_VerifyFix" name="Verify fix&#10;[TypeSafe: Noul]">
      <bpmn:documentation>TypeSafe primitive: Noul — probability the original symptom has actually cleared, given fresh telemetry as state. This is a "verify and escalate" pattern: the same class of judgment that authorized the action does not get to also grade its own result unchecked.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="typesafe-verify-fix"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_Resolved" name="Resolved?" default="Flow_Escalate">
      <bpmn:documentation>Human-in-the-loop gate 2. Anything not confidently verified resolved escalates by default — the safe branch is the one requiring no condition to match.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolvedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_HumanTriage" name="Human on-call triage">
      <bpmn:documentation>Reached when the pattern-match confidence is low, or the candidate action isn't reversible. The on-call engineer sees the same enrichment and classification the agent saw, plus the agent's own Choice/Noul outputs, framed as a short plain-language summary — not a raw telemetry dump.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHumanTriage</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EscalateHuman" name="Escalate to human&#10;(fix didn&#39;t verify)">
      <bpmn:documentation>The auto-remediation ran but the verification judgment couldn't confirm the symptom cleared. A human takes over with full context, including what was already tried.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Converge" name="">
      <bpmn:documentation>Converging exclusive gateway: whichever path the incident took (auto-resolved, human-triaged, or escalated after a failed auto-fix), it always reaches the postmortem step next. No path skips the record.</bpmn:documentation>
      <bpmn:incoming>Flow_ResolvedYes</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Postmortem" name="Generate structured&#10;postmortem (always)">
      <bpmn:documentation>Code assembles the fixed-shape record: what happened, what the agent did (playbook, confidence), what the human did and why, and (once confirmed) root cause. Runs regardless of outcome — an auto-resolved incident that leaves no trace is a wasted learning opportunity.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-postmortem"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_ClusterProblem" name="Cluster into candidate&#10;problem [TypeSafe: Score]">
      <bpmn:documentation>TypeSafe primitive: Score — similarity of this postmortem to existing problem clusters, given prior incident records as state (a "find and judge evidence" / composite-scoring pattern). The agent proposes a cluster; it never auto-confirms root cause.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="typesafe-cluster-problem"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_CSISignal" name="Signal strong enough&#10;to raise?" default="Flow_NoAction">
      <bpmn:documentation>Human-in-the-loop gate 3. Only a strong cluster Score routes to a human for prioritisation; a weak or one-off signal closes with "no action needed" recorded explicitly, so the same non-issue doesn't get re-litigated next quarter.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_CSIRaise</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoAction</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ConfirmRootCause" name="Human: confirm root&#10;cause &amp; CSI priority">
      <bpmn:documentation>A human confirms root cause and decides whether to fund the improvement. The agent's job was to make this confirmation fast by presenting correlated evidence, never to short-circuit the judgment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CSIRaise</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_ClosedNoAction" name="Closed &#8212;&#10;no CSI action">
      <bpmn:incoming>Flow_NoAction</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_ClosedCSI" name="Closed &#8212;&#10;CSI proposal raised">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Alert" targetRef="Task_Enrich"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Enrich" targetRef="Task_ClassifySeverity"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ClassifySeverity" targetRef="Task_MatchPattern"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_MatchPattern" targetRef="Gateway_AutoCandidate"/>
    <bpmn:sequenceFlow id="Flow_ToAutoRemediate" name="confidence &#8805; 0.8 &amp; reversible" sourceRef="Gateway_AutoCandidate" targetRef="Task_AutoRemediate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=matchConfidence &gt;= 0.8 and reversible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToHumanTriage" name="default" sourceRef="Gateway_AutoCandidate" targetRef="Task_HumanTriage"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AutoRemediate" targetRef="Task_VerifyFix"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_VerifyFix" targetRef="Gateway_Resolved"/>
    <bpmn:sequenceFlow id="Flow_ResolvedYes" name="verified = true" sourceRef="Gateway_Resolved" targetRef="Gateway_Converge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Escalate" name="default (not verified)" sourceRef="Gateway_Resolved" targetRef="Task_EscalateHuman"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_HumanTriage" targetRef="Gateway_Converge"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_EscalateHuman" targetRef="Gateway_Converge"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Converge" targetRef="Task_Postmortem"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Postmortem" targetRef="Task_ClusterProblem"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ClusterProblem" targetRef="Gateway_CSISignal"/>
    <bpmn:sequenceFlow id="Flow_CSIRaise" name="cluster score &#8805; 0.6" sourceRef="Gateway_CSISignal" targetRef="Task_ConfirmRootCause">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clusterScore &gt;= 0.6</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAction" name="default" sourceRef="Gateway_CSISignal" targetRef="End_ClosedNoAction"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ConfirmRootCause" targetRef="End_ClosedCSI"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1" name="Agentic Incident Triage">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Incident">
      <bpmndi:BPMNShape id="Participant_Incident_di" bpmnElement="Participant_Incident" isHorizontal="true"><dc:Bounds x="40" y="60" width="1920" height="600"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true"><dc:Bounds x="70" y="60" width="1890" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Human_di" bpmnElement="Lane_Human" isHorizontal="true"><dc:Bounds x="70" y="400" width="1890" height="260"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Alert_di" bpmnElement="StartEvent_Alert"><dc:Bounds x="100" y="262" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="82" y="305" width="72" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Enrich_di" bpmnElement="Task_Enrich"><dc:Bounds x="180" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClassifySeverity_di" bpmnElement="Task_ClassifySeverity"><dc:Bounds x="330" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MatchPattern_di" bpmnElement="Task_MatchPattern"><dc:Bounds x="480" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AutoCandidate_di" bpmnElement="Gateway_AutoCandidate" isMarkerVisible="true"><dc:Bounds x="630" y="255" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="615" y="212" width="80" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoRemediate_di" bpmnElement="Task_AutoRemediate"><dc:Bounds x="780" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyFix_di" bpmnElement="Task_VerifyFix"><dc:Bounds x="930" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Resolved_di" bpmnElement="Gateway_Resolved" isMarkerVisible="true"><dc:Bounds x="1080" y="255" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1085" y="225" width="60" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Converge_di" bpmnElement="Gateway_Converge" isMarkerVisible="true"><dc:Bounds x="1250" y="255" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Postmortem_di" bpmnElement="Task_Postmortem"><dc:Bounds x="1400" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClusterProblem_di" bpmnElement="Task_ClusterProblem"><dc:Bounds x="1550" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CSISignal_di" bpmnElement="Gateway_CSISignal" isMarkerVisible="true"><dc:Bounds x="1700" y="255" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1690" y="212" width="70" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ClosedNoAction_di" bpmnElement="End_ClosedNoAction"><dc:Bounds x="1850" y="262" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1835" y="305" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_HumanTriage_di" bpmnElement="Task_HumanTriage"><dc:Bounds x="630" y="480" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscalateHuman_di" bpmnElement="Task_EscalateHuman"><dc:Bounds x="1080" y="480" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmRootCause_di" bpmnElement="Task_ConfirmRootCause"><dc:Bounds x="1700" y="480" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ClosedCSI_di" bpmnElement="End_ClosedCSI"><dc:Bounds x="1850" y="502" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1835" y="545" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="136" y="280"/><di:waypoint x="180" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="280" y="280"/><di:waypoint x="330" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="430" y="280"/><di:waypoint x="480" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="580" y="280"/><di:waypoint x="630" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAutoRemediate_di" bpmnElement="Flow_ToAutoRemediate"><di:waypoint x="680" y="280"/><di:waypoint x="780" y="280"/><bpmndi:BPMNLabel><dc:Bounds x="683" y="252" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHumanTriage_di" bpmnElement="Flow_ToHumanTriage"><di:waypoint x="655" y="305"/><di:waypoint x="655" y="520"/><di:waypoint x="630" y="520"/><bpmndi:BPMNLabel><dc:Bounds x="660" y="400" width="40" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="880" y="280"/><di:waypoint x="930" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1030" y="280"/><di:waypoint x="1080" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ResolvedYes_di" bpmnElement="Flow_ResolvedYes"><di:waypoint x="1105" y="255"/><di:waypoint x="1105" y="200"/><di:waypoint x="1275" y="200"/><di:waypoint x="1275" y="255"/><bpmndi:BPMNLabel><dc:Bounds x="1140" y="182" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalate_di" bpmnElement="Flow_Escalate"><di:waypoint x="1105" y="305"/><di:waypoint x="1105" y="520"/><di:waypoint x="1080" y="520"/><bpmndi:BPMNLabel><dc:Bounds x="1110" y="400" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="730" y="560"/><di:waypoint x="730" y="610"/><di:waypoint x="1260" y="610"/><di:waypoint x="1260" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1180" y="560"/><di:waypoint x="1180" y="590"/><di:waypoint x="1290" y="590"/><di:waypoint x="1290" y="255"/><di:waypoint x="1280" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1300" y="280"/><di:waypoint x="1400" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1500" y="280"/><di:waypoint x="1550" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1650" y="280"/><di:waypoint x="1700" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CSIRaise_di" bpmnElement="Flow_CSIRaise"><di:waypoint x="1725" y="305"/><di:waypoint x="1725" y="520"/><di:waypoint x="1700" y="520"/><bpmndi:BPMNLabel><dc:Bounds x="1730" y="400" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoAction_di" bpmnElement="Flow_NoAction"><di:waypoint x="1750" y="280"/><di:waypoint x="1850" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1800" y="520"/><di:waypoint x="1850" y="520"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
